eight:0.6779em;&#34;&gt;&lt;span style=&#34;top:-2.989em;margin-right:0.05em;&#34;&gt;&lt;span class=&#34;pstrut&#34; style=&#34;height:2.7em;&#34;&gt;&lt;/span&gt;&lt;span class=&#34;sizing reset-size6 size3 mtight&#34;&gt;&lt;span class=&#34;mord mtight&#34;&gt;&lt;span class=&#34;mord mtight&#34;&gt;′&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;top:-3.23em;&#34;&gt;&lt;span class=&#34;pstrut&#34; style=&#34;height:3em;&#34;&gt;&lt;/span&gt;&lt;span class=&#34;frac-line&#34; style=&#34;border-bottom-width:0.04em;&#34;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;top:-3.677em;&#34;&gt;&lt;span class=&#34;pstrut&#34; style=&#34;height:3em;&#34;&gt;&lt;/span&gt;&lt;span class=&#34;mord&#34;&gt;&lt;span class=&#34;mord&#34;&gt;&lt;span class=&#34;mord mathnormal&#34; style=&#34;margin-right:0.07153em;&#34;&gt;Z&lt;/span&gt;&lt;span class=&#34;msupsub&#34;&gt;&lt;span class=&#34;vlist-t&#34;&gt;&lt;span class=&#34;vlist-r&#34;&gt;&lt;span class=&#34;vlist&#34; style=&#34;height:0.7519em;&#34;&gt;&lt;span style=&#34;top:-3.063em;margin-right:0.05em;&#34;&gt;&lt;span class=&#34;pstrut&#34; style=&#34;height:2.7em;&#34;&gt;&lt;/span&gt;&lt;span class=&#34;sizing reset-size6 size3 mtight&#34;&gt;&lt;span class=&#34;mord mtight&#34;&gt;&lt;span class=&#34;mord mtight&#34;&gt;′′&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;vlist-s&#34;&gt;​&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;vlist-r&#34;&gt;&lt;span class=&#34;vlist&#34; style=&#34;height:0.686em;&#34;&gt;&lt;span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;mclose nulldelimiter&#34;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;mclose delimcenter&#34; style=&#34;top:0em;&#34;&gt;&lt;span class=&#34;delimsizing size3&#34;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;p&gt;其中相位角输出为度（&lt;code&gt;phase_deg&lt;/code&gt;）。&lt;/p&gt;
&lt;h2&gt;输出文件说明&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;输出文件说明&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e8%be%93%e5%87%ba%e6%96%87%e4%bb%b6%e8%af%b4%e6%98%8e&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;p&gt;每个 &lt;code&gt;*_eis.csv&lt;/code&gt; 至少包含：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;code&gt;freq_hz&lt;/code&gt;：频率（Hz）&lt;/li&gt;
&lt;li&gt;&lt;code&gt;z_real_ohm&lt;/code&gt;：阻抗实部（Ω）&lt;/li&gt;
&lt;li&gt;&lt;code&gt;z_imag_ohm&lt;/code&gt;：阻抗虚部（Ω）&lt;/li&gt;
&lt;li&gt;&lt;code&gt;z_mod_ohm&lt;/code&gt;：阻抗模值（Ω）&lt;/li&gt;
&lt;li&gt;&lt;code&gt;phase_deg&lt;/code&gt;：相位角（°）&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;后续推荐&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;后续推荐&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e5%90%8e%e7%bb%ad%e6%8e%a8%e8%8d%90&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;ul&gt;
&lt;li&gt;&lt;a href=&#34;http://localhost:1313/docs/eis/plot/&#34;&gt;EIS 绘图：Nyquist 和 Bode&lt;/a&gt;：快速查看 Nyquist/Bode 图形质量与趋势&lt;/li&gt;
&lt;li&gt;&lt;a href=&#34;http://localhost:1313/docs/eis/drt/&#34;&gt;EIS/DRT 分析&lt;/a&gt;：进一步做 DRT 弛豫时间分布分析&lt;/li&gt;
&lt;/ul&gt;

      </description>
